{
  "name": "issue-triage-cli",
  "version": "1.0.1",
  "description": "CLI for open-source maintainers to triage GitHub issues and PRs (stale detection, label suggestions, markdown reports)",
  "bin": {
    "issue-triage": "bin/issue-triage.js"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node bin/issue-triage.js",
    "test": "node --test test/*.test.js",
    "help": "node bin/issue-triage.js --help"
  },
  "keywords": [
    "github",
    "maintainer",
    "triage",
    "cli",
    "open-source",
    "issues",
    "pull-requests",
    "codex",
    "stale",
    "labels"
  ],
  "files": [
    "bin/",
    "src/",
    "LICENSE",
    "README.md",
    "triage.config.example.json"
  ],
  "author": "Eliksey",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Eliksey/issue-triage-cli.git"
  }
}
